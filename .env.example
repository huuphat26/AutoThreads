# ============================================
# AUTO THREADS - ENVIRONMENT CONFIG
# ============================================
# ⚠️ IMPORTANT: Copy this file to .env and fill in your values
# ⚠️ NEVER commit .env file to git!

# ============================================
# SECTION 1: CRITICAL - Meta/Threads API
# ============================================
# Get from: https://developers.facebook.com/apps/
# 1. Create app → Add Threads product
# 2. App Settings > Basic
THREADS_APP_ID=your_app_id_here
THREADS_APP_SECRET=your_app_secret_here

# Long-lived access token (valid 60 days)
# Get from: https://developers.facebook.com/docs/threads/get-started
# Run: node get-token.sh after setup
THREADS_ACCESS_TOKEN=your_long_lived_access_token_here

# Auto-fetch on first run
THREADS_USER_ID=your_threads_user_id_here


# ============================================
# SECTION 2: OPTIONAL - AI Providers
# ============================================
# Choose ONE provider below:

# --- Option A: OpenAI (Recommended) ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Option B: Google Gemini ---
# Get from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here


# ============================================
# SECTION 3: OPTIONAL - Cloud Storage
# ============================================
# Only needed for AI image generation feature
# Get from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_UPLOAD_FOLDER=autothreads


# ============================================
# SECTION 4: SCHEDULER CONFIG
# ============================================
# Timezone (Vietnam)
TIMEZONE=Asia/Ho_Chi_Minh

# Threads-only scheduler (true/false)
SCHEDULER_ENABLED=true

# Auto 3-platform scheduler (true/false)
# Flow: FB → wait 2min → Threads → wait 2min → IG
AUTO_SCHEDULER_ENABLED=false


# ============================================
# SECTION 5: APP CONFIG
# ============================================
# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for cron job protection
# Generate: openssl rand -base64 32
CRON_SECRET=change_this_to_random_string


# ============================================
# SECTION 6: VERCEL KV (Production only)
# ============================================
# Only needed when deploying to Vercel
# Get from: Vercel Dashboard > Storage > KV > .env
# KV_REST_API_URL=your_kv_rest_api_url_here
# KV_REST_API_TOKEN=your_kv_rest_api_token_here
