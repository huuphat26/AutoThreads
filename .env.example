# ============================================
# AUTO THREADS - CẤU HÌNH MÔI TRƯỜNG
# ============================================
# Copy file này thành .env và điền giá trị thực

# --- META / THREADS API ---
# Lấy từ https://developers.facebook.com/apps/
THREADS_APP_ID=your_app_id_here
THREADS_APP_SECRET=your_app_secret_here

# Access Token dài hạn (Long-lived token) của tài khoản Threads của bạn
# Hướng dẫn lấy: https://developers.facebook.com/docs/threads/get-started
THREADS_ACCESS_TOKEN=your_long_lived_access_token_here

# User ID của tài khoản Threads (sẽ tự động lấy khi chạy lần đầu)
THREADS_USER_ID=your_threads_user_id_here

# --- OPENAI API ---
# Lấy từ https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model AI sử dụng (gpt-4o-mini tiết kiệm chi phí, gpt-4o chất lượng cao hơn)
OPENAI_MODEL=gpt-4o-mini

# --- SCHEDULER ---
# Múi giờ (Việt Nam = Asia/Ho_Chi_Minh)
TIMEZONE=Asia/Ho_Chi_Minh

# Bật/tắt scheduler tự động CHỈ Threads (true/false)
SCHEDULER_ENABLED=true

# Lịch đăng bài mặc định: 12:00 và 18:00 mỗi ngày (tổng 2 bài/ngày)
# Để override, đặt CRON_SCHEDULES theo format: "Label|cron;Label2|cron2"
# Ví dụ: CRON_SCHEDULES=Buổi sáng|0 8 * * *;Buổi trưa|0 12 * * *;Buổi tối|0 18 * * *
# CRON_SCHEDULES=

# Bật/tắt Auto Scheduler 3 nền tảng (FB → Threads → IG) lúc 12:00 & 18:00
# Flow: AI soạn nội dung → đăng FB → chờ 2 phút → Threads → chờ 2 phút → IG
# Đặt true để bật, false để tắt
AUTO_SCHEDULER_ENABLED=false

# --- APP ---
# URL của app (dùng cho internal API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key để bảo vệ API nội bộ
CRON_SECRET=your_random_secret_here_change_this
